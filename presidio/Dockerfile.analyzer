FROM mcr.microsoft.com/presidio-analyzer:latest

# Trust the corporate TLS-intercepting proxy CA so pip and requests can reach
# external hosts during build. corp-ca.crt is generated by refresh-corp-ca.sh.
USER root
COPY corp-ca.crt /usr/local/share/ca-certificates/corp-ca.crt
RUN update-ca-certificates \
    && cp /etc/ssl/certs/ca-certificates.crt \
          /usr/local/lib/python3.12/site-packages/certifi/cacert.pem

# Add German to the list of supported recognizer languages
COPY default_analyzer.yaml /app/presidio_analyzer/conf/default_analyzer.yaml
COPY default_recognizers.yaml /app/presidio_analyzer/conf/default_recognizers.yaml

# Install the German spaCy model, then drop back to the service user
RUN python -m spacy download de_core_news_lg
USER presidio
