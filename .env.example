# =====================================================================
# Secure Hermes Sandbox — environment template
# =====================================================================
#
# Copy this file to `.env` (setup.sh does this automatically) and fill in
# values for the variables you actually need. Everything is optional for
# a default local-only run.
#
# Two scopes of secrets exist in this project:
#
#   1. HOST-SIDE keys (this file)
#      Consumed by the docker-compose stack (Firecrawl, etc.). They never
#      enter the Hermes sandbox.
#
#   2. SANDBOX-SIDE keys (NOT here)
#      Hermes' own LLM-provider credentials are entered INSIDE the sandbox
#      via `hermes setup`. They are stored under ~/.hermes/ in the sandbox
#      and persist across restarts (the kit declares persistence: persistent).
#      Putting them in this file would leak them into the host environment
#      where they don't belong.
#
# ---------------------------------------------------------------------

# --- Firecrawl ---------------------------------------------------------
# Self-hosted Firecrawl runs with USE_DB_AUTHENTICATION=false by default,
# so you do not need an API key. Set one only if you've enabled auth.
FIRECRAWL_API_KEY=

# Optional: point Firecrawl at a SearXNG instance for the /search backend.
# Leave blank to use Firecrawl's default search behaviour.
SEARXNG_ENDPOINT=
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=

# Optional outbound proxy for Firecrawl's scraper (most users leave blank).
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional: extraction model config for Firecrawl. Most users leave blank.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
MODEL_EMBEDDING_NAME=
OLLAMA_BASE_URL=

# --- Logging ----------------------------------------------------------
LOGGING_LEVEL=info
