# Host-side, non-secret config. Secrets do not go here.
# LLM keys: `sbx secret set -g <provider>` on the host.
# Firecrawl runs with USE_DB_AUTHENTICATION=false, no key needed.

# Optional SearXNG instance for Firecrawl's /search backend; leaving it
# empty falls back to Google scraping which is rate-limited.
SEARXNG_ENDPOINT=
